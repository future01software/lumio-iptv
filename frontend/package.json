{
  "name": "frontend",
  "description": "IPTV Player Desktop Application",
  "author": "IPTV Player Team",
  "main": "expo-router/entry",
  "version": "1.1.8",
  "scripts": {
    "preinstall": "node ./scripts/cmd-guard.js --preinstall",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "electron-app": "electron electron/main.js",
    "desktop": "electron electron/main.js",
    "build:electron": "npx expo export -p web --clear && electron-builder",
    "build:backend": "cd ../backend && venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --onedir --name lumio-backend --distpath pyinstaller-dist --workpath pyinstaller-build --specpath pyinstaller-build --collect-submodules uvicorn --hidden-import logo_db run_backend.py",
    "build:msi": "npm run build:backend && npx expo export -p web --clear && electron-builder --win msi"
  },
  "dependencies": {
    "@dicebear/avataaars": "9.4.2",
    "@dicebear/bottts": "9.4.2",
    "@dicebear/core": "9.4.3",
    "@dicebear/lorelei": "9.4.2",
    "@dicebear/notionists": "9.4.2",
    "@dicebear/open-peeps": "9.4.2",
    "@dicebear/pixel-art": "9.4.2",
    "@dicebear/thumbs": "9.4.2",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@shopify/flash-list": "2.0.2",
    "crypto-js": "4.2.0",
    "date-fns": "4.1.0",
    "dayjs": "1.11.13",
    "expo": "54.0.35",
    "expo-blur": "15.0.8",
    "expo-brightness": "~14.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "14.0.12",
    "expo-haptics": "15.0.8",
    "expo-image": "3.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-router": "6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "15.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-symbols": "1.0.8",
    "expo-system-ui": "6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "15.0.11",
    "hls.js": "1.6.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "3.4.11",
    "react-native-gesture-handler": "2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-cast": "4.9.1",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-ssl-public-key-pinning": "1.2.6",
    "react-native-vlc-media-player": "1.0.98",
    "react-native-web": "0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/crypto-js": "4.2.2",
    "@types/react": "19.1.10",
    "electron": "42.5.0",
    "electron-builder": "26.15.3",
    "eslint": "9.25.0",
    "eslint-config-expo": "10.0.0",
    "expo-doctor": "1.19.8",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@eslint/plugin-kit": "0.3.4",
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "build": {
    "appId": "com.iptvplayer.desktop",
    "productName": "Lumio IPTV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "../backend/pyinstaller-dist/lumio-backend",
        "to": "backend/lumio-backend"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "msi"
      ],
      "icon": "assets/images/icon-desktop.ico"
    },
    "msi": {
      "perMachine": false,
      "oneClick": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumio IPTV"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false
  }
}
